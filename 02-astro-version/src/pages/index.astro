---
import BaseLayout from "../layouts/BaseLayout.astro";
import PricingTable from "../components/PricingTable.astro";
import hook from "../data/urgentHook.json";
import hero from "../data/hero.json";
import services from "../data/services.json";
import equipment from "../data/equipment.json";
import standards from "../data/standards.json";
import pricing from "../data/pricing.json";
import faqs from "../data/faqs.json";
import galleryData from "../data/gallery.json";
import siteSettings from "../data/settings.json";
import footer from "../data/footer.json";
import txt from "../data/pageText.json";
import { contact, withQuery, fillSchema } from "../lib/contact";
import { heroMobilePath, HERO_MOBILE_MAX, HERO_DESKTOP_MIN } from "../lib/hero-mobile.mjs";
import homeSections from "../data/homeSections.json";
// Homepage section order/visibility from the CMS. Pure CSS (no markup changes) so the default page is byte-identical;
// shortcut: reordering uses flex on <main>, so margins between sections no longer collapse, check spacing if reordered.
const SEC = {"proof": [".proof"], "services": ["#services", ".service-promise"], "equipment": ["#equipment"], "gallery": ["#gallery"], "standards": ["#standards"], "license": ["#license"], "pricing": ["#pricing", "#packages"], "reviews": ["#reviews"], "hook": ["#kinetic-hook"], "coverage": ["#coverage"], "contact": ["#contact"], "faq": ["#faq"], "social": [".social-section"]};
const secList = homeSections.sections.filter((x, i, a) => SEC[x.id] && a.findIndex((y) => y.id === x.id) === i);
const secAll = [...secList, ...Object.keys(SEC).filter((k) => !secList.some((x) => x.id === k)).map((id) => ({ id, enabled: true }))];
const defaultOrder = Object.keys(SEC).join();
const secCss = (secAll.map((x) => x.id).join() === defaultOrder ? "" :
  "main{display:flex;flex-direction:column}main>*{width:100%;box-sizing:border-box}.topbar{order:-20}.hero{order:-10}main>footer{order:100}" +
  secAll.map((x, i) => SEC[x.id].map((c) => `${c}{order:${i + 1}}`).join("")).join("")) +
  secAll.filter((x) => x.enabled === false).map((x) => SEC[x.id].map((c) => `${c}{display:none!important}`).join("")).join("") +
  secAll.filter((x) => x.enabled === false).map((x) => SEC[x.id].filter((c) => c[0] === "#").map((c) => `.topbar nav a[href="${c}"]{display:none}`).join("")).join("");
const blogOn = siteSettings.blogEnabled !== false;
const logo = siteSettings.logo;
const heroMobile = heroMobilePath(hero.slides[0]);
// Same gradient as the slide's inline style; !important beats it so phones never fetch the full image
const heroMobileCss = `@media ${HERO_MOBILE_MAX}{.hero-slides>.hero-slide:first-child{background-image:linear-gradient(90deg,rgba(9,14,11,.93) 0%,rgba(9,14,11,.68) 48%,rgba(9,14,11,.12) 100%),url("${heroMobile}")!important;background-position:50%!important}}`;
const registrationText = `${footer.registrationLabel} • ${contact.taxID}`;
import homeSchema from "../schema/home.json";


// Admin "featured" item(s) first, then the order set in the CMS list (sort is stable)
const galleryItems = [...galleryData.items].sort((a, b) => Number(!!b.featured) - Number(!!a.featured));
const galleryCount = (cat) => cat === "all" ? galleryItems.length : galleryItems.filter((g) => g.category === cat).length;
const posterOf = (g) => g.type === "video" ? (g.poster || g.src.replace(/\.webm$/i, "-poster.jpg")) : g.src;
const galleryFirstSrc = posterOf(galleryItems[0]).replace(/^\.\//, "/");

// Thai text -> English pairs; standalone.js merges these into its translation dictionary
const pairs = [
  [hero.heading.line1Th, hero.heading.line1En], [hero.heading.line2Th, hero.heading.line2En], [hero.lead.th, hero.lead.en],
  [services.leadTh, services.leadEn],
  ...services.items.flatMap((x) => [[x.desc, x.descEn], [x.price, x.priceEn]]),
  [equipment.isoNote, equipment.isoNoteEn], [equipment.footnote, equipment.footnoteEn],
  ...equipment.items.flatMap((x) => [[x.title, x.titleEn], [x.desc, x.descEn]]),
  [standards.leadTh, standards.leadEn],
  ...standards.items.flatMap((x) => [[x.title, x.titleEn], [x.desc, x.descEn]]),
  [pricing.headingTh, pricing.headingEn], [pricing.leadTh, pricing.leadEn], [pricing.fineprint, pricing.fineprintEn],
  ...pricing.cards.flatMap((x) => [[x.title, x.titleEn], [x.price, x.priceEn], [x.desc, x.descEn]]),
  [faqs.headingTh, faqs.headingEn],
  [contact.phoneName, contact.phoneNameEn], [contact.phoneSecondaryName, contact.phoneSecondaryNameEn],
  [registrationText, `Legally registered • ${contact.taxID}`],
  ...faqs.items.flatMap((x) => [[x.qTh, x.qEn], [x.aTh, x.aEn]]),
  // Page text from pageText.json (CMS "ข้อความทั่วทั้งหน้าเว็บ"): stats list + every section's {th, en}
  ...txt.stats.map((s) => [s.th, s.en]),
  ...Object.entries(txt).filter(([k]) => k !== "stats").flatMap(([, sec]) => Object.values(sec).map((v) => [v.th, v.en])),
];
const jina = {
  i18n: Object.fromEntries(pairs.filter(([th, en]) => th && en && th !== en).map(([th, en]) => [th.trim(), en.trim()])),
  gallery: galleryItems,
  heroSlides: hero.slides,
};
// Structured data: static graph in src/schema/home.json + FAQ built from the same faqs.json the page shows
const SITE = new URL(siteSettings.canonicalUrl).origin;
const faqSchema = {
  "@context": "https://schema.org", "@type": "FAQPage",
  mainEntity: faqs.items.map((f) => ({ "@type": "Question", name: f.qTh, acceptedAnswer: { "@type": "Answer", text: f.aTh } })),
};
const schemaJson = fillSchema(JSON.stringify([...homeSchema, faqSchema]));
---
<BaseLayout>
<Fragment slot="preload"><link rel="preload" as="image" href={heroMobile} media={HERO_MOBILE_MAX} fetchpriority="high" /><link rel="preload" as="image" href={hero.slides[0].image} media={HERO_DESKTOP_MIN} fetchpriority="high" /></Fragment><Fragment slot="head"><style is:inline set:html={heroMobileCss}></style>{secCss && <style is:inline set:html={secCss}></style>}</Fragment>
<main><header class="topbar"><a class="brand image-brand jina-lockup" href="#home"><span class="jina-wordmark">{logo.wordmark}</span> <span class="jina-brandline">{logo.line} <b>{logo.highlight}</b></span></a><nav><a href="#services" data-bilingual="true" data-th={txt.nav.t01.th} data-en={txt.nav.t01.en}>{txt.nav.t01.th}</a><a href="#gallery" data-bilingual="true" data-th={txt.nav.t02.th} data-en={txt.nav.t02.en}>{txt.nav.t02.th}</a><a href="#standards" data-bilingual="true" data-th={txt.nav.t03.th} data-en={txt.nav.t03.en}>{txt.nav.t03.th}</a><a href="#pricing" data-bilingual="true" data-th={txt.nav.t04.th} data-en={txt.nav.t04.en}>{txt.nav.t04.th}</a><a href="#coverage" data-bilingual="true" data-th={txt.nav.t05.th} data-en={txt.nav.t05.en}>{txt.nav.t05.th}</a>{blogOn && <a href="/blog/" data-bilingual="true" data-th={txt.nav.t06.th} data-en={txt.nav.t06.en}>{txt.nav.t06.th}</a>}<a href="#faq" data-bilingual="true" data-th={txt.nav.t07.th} data-en={txt.nav.t07.en}>{txt.nav.t07.th}</a></nav><div class="nav-actions"><button class="icon-btn" data-track="theme" aria-label="Switch color mode"><svg class="theme-toggle-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="1.5" x2="12" y2="4.5"/><line x1="12" y1="19.5" x2="12" y2="22.5"/><line x1="1.5" y1="12" x2="4.5" y2="12"/><line x1="19.5" y1="12" x2="22.5" y2="12"/><line x1="4.5" y1="4.5" x2="6.6" y2="6.6"/><line x1="17.4" y1="17.4" x2="19.5" y2="19.5"/><line x1="4.5" y1="19.5" x2="6.6" y2="17.4"/><line x1="17.4" y1="6.6" x2="19.5" y2="4.5"/><circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="2" fill="none"/><path d="M 12 7 A 5 5 0 0 1 12 17 Z" fill="currentColor" stroke="none"/></svg></button><button class="lang" data-track="language">EN</button><a class="mini-cta" href="https://www.facebook.com/messages/t/100545618430726?utm_source=jina_service_website&amp;utm_medium=social&amp;utm_campaign=Veecreate&amp;utm_content=topbar_messenger" target="_blank" rel="noopener noreferrer" data-track="urgent_contact">{txt.nav.t08.th}</a><button class="mobile-menu-btn" id="mobile-menu-toggle" type="button" aria-label="เปิดเมนูนำทาง" aria-expanded="false"><span class="hamburger-line"></span><span class="hamburger-line"></span><span class="hamburger-line"></span></button></div></header><div class="mobile-nav-drawer" id="mobile-nav-drawer" aria-hidden="true"><div class="mobile-nav-inner"><nav class="mobile-nav-menu"><a href="#services" class="mobile-nav-item" data-bilingual="true" data-th={txt.mobileNav.t01.th} data-en={txt.mobileNav.t01.en}>{txt.mobileNav.t01.th}</a><a href="#gallery" class="mobile-nav-item" data-bilingual="true" data-th={txt.mobileNav.t02.th} data-en={txt.mobileNav.t02.en}>{txt.mobileNav.t02.th}</a><a href="#standards" class="mobile-nav-item" data-bilingual="true" data-th={txt.mobileNav.t03.th} data-en={txt.mobileNav.t03.en}>{txt.mobileNav.t03.th}</a><a href="#pricing" class="mobile-nav-item" data-bilingual="true" data-th={txt.mobileNav.t04.th} data-en={txt.mobileNav.t04.en}>{txt.mobileNav.t04.th}</a><a href="#coverage" class="mobile-nav-item" data-bilingual="true" data-th={txt.mobileNav.t05.th} data-en={txt.mobileNav.t05.en}>{txt.mobileNav.t05.th}</a>{blogOn && <a href="/blog/" class="mobile-nav-item" data-bilingual="true" data-th={txt.mobileNav.t06.th} data-en={txt.mobileNav.t06.en}>{txt.mobileNav.t06.th}</a>}<a href="#faq" class="mobile-nav-item" data-bilingual="true" data-th={txt.mobileNav.t07.th} data-en={txt.mobileNav.t07.en}>{txt.mobileNav.t07.th}</a></nav></div></div><section class="hero" id="home"><div class="hero-slides" aria-hidden="true">{hero.slides.map((slide, i) => (<div class={"hero-slide" + (i === 0 ? " active" : "")} style={i === 0 ? `background-image:linear-gradient(90deg,rgba(9,14,11,.93) 0%,rgba(9,14,11,.68) 48%,rgba(9,14,11,.12) 100%),url("${slide.image}");background-position:${slide.position || "center"}` : undefined}></div>))}</div><div class="hero-content wrap"><div class="hero-copy"><p class="eyebrow" data-bilingual="true" data-th={hero.eyebrow.th} data-en={hero.eyebrow.en}><i></i>{hero.eyebrow.th}</p><h1><span>{hero.heading.line1Th}</span><span>{hero.heading.line2Th}</span></h1><p class="lead">{hero.lead.th}</p><div class="hero-buttons"><a class="button primary" href="#contact" data-track="free_estimate">{txt.hero.t01.th} <b>→</b></a><a class="button ghost" href={contact.tel} data-track="hero_phone"><svg class="hero-phone-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg><span>{contact.phoneDisplay}</span></a></div><div class="trust-row">{hero.badges.map((badge) => (<span data-bilingual="true" data-th={badge.th} data-en={badge.en}>{badge.th}</span>))}</div><div class="hero-dots" aria-label="Hero images">{hero.slides.map((_, i) => (<button type="button" class={i === 0 ? "active" : ""} aria-label={`${i + 1} / ${hero.slides.length}`}></button>))}</div></div></div></section><section class="proof"><div class="wrap proof-grid">{txt.stats.map((s) => (<div><strong><span class="stat-number" data-target={s.value} data-suffix={s.suffix}>{(s.value >= 1000 ? s.value.toLocaleString("en-US") : s.value) + s.suffix}</span></strong><span class="stat-label" data-bilingual="true" data-th={s.th} data-en={s.en}>{s.th}</span></div>))}</div></section><section class="section wrap" id="services"><div class="section-head"><div><p class="kicker">{txt.services.t01.th}</p><h2 class="services-heading" data-bilingual="true" data-th={services.headingTh} data-en={services.headingEn}>{services.headingTh}</h2></div><p>{services.leadTh}</p></div><div class="service-grid">{services.items.map((item, i) => { const n = String(i + 1).padStart(2, "0"); return (<article class="service-card"><h3 data-bilingual="true" data-th={item.title} data-en={item.titleEn}>{item.title}</h3><p>{item.desc}</p><div class="service-card-footer"><div class="service-price"><small>{txt.services.t02.th}</small><strong>{item.price}</strong></div><a href="#contact" data-track={`service_estimate_${n}`}>{txt.services.t03.th}</a></div></article>); })}</div></section>{services.promise && services.promise.enabled !== false && (<aside class="service-promise"><strong data-bilingual="true" data-th={services.promise.titleTh} data-en={services.promise.titleEn}>{services.promise.titleTh}</strong><span style="white-space:pre-line" data-bilingual="true" data-th={services.promise.textTh} data-en={services.promise.textEn}>{services.promise.textTh}</span><a href="#contact" data-bilingual="true" data-th={services.promise.buttonTh} data-en={services.promise.buttonEn}>{services.promise.buttonTh}</a></aside>)}<section class="equipment-section" id="equipment"><div class="wrap"><div class="equipment-head"><div><p class="kicker">{txt.equipment.t01.th}</p><h2><span data-bilingual="true" data-th={equipment.headingTh} data-en={equipment.headingEn}>{equipment.headingTh}</span></h2></div><div class="iso-note"><span>ISO</span><p>{equipment.isoNote}</p></div></div><div class="equipment-grid">{equipment.items.map((item) => (<article><span aria-hidden="true">✓</span><h3>{item.title}</h3><p>{item.desc}</p></article>))}</div><p class="equipment-footnote">{equipment.footnote}</p></div></section><section class="work-gallery" id="gallery" aria-labelledby="work-heading"><div class="wrap"><div class="section-head"><div><p class="kicker">{txt.gallery.t01.th}</p><h2 id="work-heading">{txt.gallery.t02.th}</h2></div><p data-bilingual="true" data-th={txt.gallery.t03.th} data-en={txt.gallery.t03.en}>{txt.gallery.t03.th}</p></div><div class="gallery-filters" aria-label="เลือกประเภทงาน"><button class="active" type="button" data-category="all">{txt.gallery.t04.th} <span class="filter-count">{galleryCount("all")}</span></button><button class="" type="button" data-category="fleet">{txt.gallery.t05.th} <span class="filter-count">{galleryCount("fleet")}</span></button><button class="" type="button" data-category="septic">{txt.gallery.t06.th} <span class="filter-count">{galleryCount("septic")}</span></button><button class="" type="button" data-category="edc">{txt.gallery.t07.th} <span class="filter-count">{galleryCount("edc")}</span></button><button class="" type="button" data-category="dredge">{txt.gallery.t08.th} <span class="filter-count">{galleryCount("dredge")}</span></button><button class="" type="button" data-category="tank">{txt.gallery.t09.th} <span class="filter-count">{galleryCount("tank")}</span></button><button class="" type="button" data-category="video">{txt.gallery.t10.th} <span class="filter-count">{galleryCount("video")}</span></button></div><div class="gallery-toolbar"><div class="gallery-counter"><span class="counter-prefix" data-bilingual data-th={txt.gallery.t11.th} data-en={txt.gallery.t11.en}>{txt.gallery.t11.th}</span> <span id="gallery-current-num">1</span> <span class="counter-divider" data-bilingual data-th={txt.gallery.t12.th} data-en={txt.gallery.t12.en}>{txt.gallery.t12.th}</span> <span id="gallery-total-num">{galleryItems.length}</span></div><div class="gallery-view-mode" role="group" aria-label="รูปแบบการแสดงผล"><button class="view-mode-btn active" type="button" data-mode="carousel" title="มุมมองสไลด์โชว์พร้อมภาพย่อ"><span data-bilingual data-th={txt.gallery.t13.th} data-en={txt.gallery.t13.en}>{txt.gallery.t13.th}</span></button><button class="view-mode-btn" type="button" data-mode="grid" title="ดูภาพทั้งหมดแบบตาราง"><span data-bilingual data-th={txt.gallery.t14.th} data-en={txt.gallery.t14.en}>{txt.gallery.t14.th}</span></button></div></div><div class="gallery-ca