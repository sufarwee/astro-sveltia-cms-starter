---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import siteSettings from '../../data/settings.json';
import { contact } from '../../lib/contact';
import bp from '../../data/blogPage.json';

if (siteSettings.blogEnabled === false) return Astro.redirect("/");
const posts = await getCollection('blog', (post) => post.data.published);
posts.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

const pageTitle = bp.seoTitle;
const pageDescription = bp.seoDescription;
const SITE = new URL(siteSettings.canonicalUrl).origin;
const canonicalUrl = `${SITE}/blog/`;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "หน้าหลัก",
      "item": `${SITE}/`
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "สาระน่ารู้ (Blog)",
      "item": canonicalUrl
    }
  ]
};
---

<BaseLayout title={pageTitle} description={pageDescription} canonical={canonicalUrl} noindex={posts.length === 0}>
  <!-- Top Navigation -->
  <header class="topbar">
    <a class="brand image-brand jina-lockup" href="/" aria-label="JINA SERVICE Phuket"><span class="jina-wordmark" aria-hidden="true">{siteSettings.logo.wordmark}</span><span class="jina-brandline" aria-hidden="true">{siteSettings.logo.line} <b>{siteSettings.logo.highlight}</b></span></a>
    <nav>
      <a href="/#services">บริการ</a>
      <a href="/#gallery">แกลเลอรี</a>
      <a href="/#standards">มาตรฐาน</a>
      <a href="/#pricing">ราคา</a>
      <a href="/#coverage">พื้นที่บริการ</a>
      <a href="/blog/" class="active" style="color: var(--jina-green, #0aa84f); font-weight: 700;">บทความ</a>
      <a href="/#faq">คำถามพบบ่อย</a>
    </nav>
    <div class="nav-actions">
      <button class="icon-btn theme-toggle-btn" id="theme-toggle-btn" aria-label="Switch color mode">◐</button>
      <a class="mini-cta" href={contact.tel} data-track="urgent_contact">☎ {contact.phoneDisplay}</a>
    </div>
  </header>

  <main style="padding-top: 100px; padding-bottom: 80px; min-height: 80vh;">
    <!-- Breadcrumb -->
    <div class="wrap" style="margin-bottom: 24px;">
      <nav class="breadcrumb-nav" aria-label="Breadcrumb" style="font-size: 14px; color: var(--jina-muted, #53655b);">
        <ol style="display: flex; flex-wrap: wrap; list-style: none; padding: 0; margin: 0; gap: 8px; align-items: center;">
          <li><a href="/" style="color: inherit; text-decoration: none;">หน้าหลัก</a></li>
          <li aria-hidden="true" style="opacity: 0.6;">/</li>
          <li aria-current="page" style="color: var(--jina-green, #0aa84f); font-weight: 700;">สาระน่ารู้ (Blog)</li>
        </ol>
      </nav>
    </div>

    <!-- Header Section -->
    <section class="wrap" style="margin-bottom: 48px; text-align: center;">
      <span style="display: inline-block; background: color-mix(in srgb, var(--jina-green) 14%, transparent); color: var(--jina-green, #0aa84f); padding: 4px 14px; border-radius: 50px; font-size: 13px; font-weight: 700; margin-bottom: 12px; border: 1px solid color-mix(in srgb, var(--jina-green) 30%, transparent);">
        {bp.badge}
      </span>
      <h1 style="font-size: clamp(18px, 5vw, 42px); white-space: nowrap; font-weight: 800; line-height: 1.3; margin: 8px 0 16px 0; color: var(--jina-text);">
        {bp.title}
      </h1>
      <p style="font-size: 16.5px; line-height: 1.6; color: var(--jina-muted); max-width: 680px; margin: 0 auto;">
        {bp.intro}
      </p>
    </section>

    <!-- Post Grid -->
    <section class="wrap">
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 28px;">
        {posts.length === 0 && (
          <p style="grid-column: 1 / -1; text-align: center; color: var(--jina-muted); padding: 48px 0;">บทความกำลังจะมาเร็วๆ นี้ ระหว่างนี้ปรึกษาทีมช่างได้ที่ <a href={contact.tel}>{contact.phoneDisplay}</a></p>
        )}
        {posts.map(post => (
          <article style="border-radius: 16px; overflow: hidden; background: var(--jina-surface); border: 1px solid var(--jina-border); box-shadow: var(--jina-shadow); transition: transform 0.2s, box-shadow 0.2s; display: flex; flex-direction: column;">
            <a href={`/blog/${post.slug}/`} style="display: block; aspect-ratio: 16/9; overflow: hidden; background: var(--jina-surface-2);">
              <img
                src={post.data.coverImage}
                alt={post.data.coverAlt}
                width="640"
                height="360"
                loading="lazy"
                style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s;"
              />
            </a>
            <div style="padding: 24px; display: flex; flex-direction: column; flex-grow: 1;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; font-size: 13px;">
                <span style="color: var(--jina-green); font-weight: 700;">{post.data.category}</span>
                <time style="color: var(--jina-muted);" datetime={typeof post.data.pubDate === 'string' ? post.data.pubDate : post.data.pubDate.toISOString().split('T')[0]}>
                  {typeof post.data.pubDate === 'string' ? post.data.pubDate : post.data.pubDate.toISOString().split('T')[0]}
                </time>
              </div>
              <h2 style="font-size: 20px; font-weight: 700; line-height: 1.4; margin: 0 0 12px 0;">
                <a href={`/blog/${post.slug}/`} style="color: var(--jina-text); text-decoration: none;">
                  {post.data.title}
                </a>
              </h2>
              <p style="font-size: 14.5px; line-height: 1.6; color: var(--jina-muted); margin: 0 0 20px 0; flex-grow: 1;">
                {post.data.description}
              </p>
              <a href={`/blog/${post.slug}/`} style="font-size: 14.5px; font-weight: 700; color: var(--jina-green); text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                อ่านบทความฉบับเต็ม →
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)}></script>

  <!-- Theme Toggle Script -->
  <script is:inline>
    (function() {
      const urlParams = new URLSearchParams(window.location.search);
      const queryTheme = urlParams.get('theme');
      const savedTheme = queryTheme || localStorage.getItem('jina-theme') || 'dark';
      document.documentElement.dataset.theme = savedTheme;
      
      const themeBtn = document.getElementById('theme-toggle-btn');
      if (themeBtn) {
        themeBtn.textContent = savedTheme === 'dark' ? '☀' : '◐';
        themeBtn.addEventListener('click', function() {
          const currentTheme = document.documentElement.dataset.theme;
          const nextTheme = currentTheme === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = nextTheme;
          localStorage.setItem('jina-theme', nextTheme);
          themeBtn.textContent = nextTheme === 'dark' ? '☀' : '◐';
        });
      }
    })();
  </script>
</BaseLayout>
